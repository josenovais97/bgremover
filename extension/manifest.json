{
  "manifest_version": 3,
  "name": "ClearBG \u2014 right-click image tools",
  "version": "1.0.0",
  "description": "Right-click any image on the web to remove its background, crop, compress or convert it. Everything runs in your browser \u2014 nothing is uploaded.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "https://clearbg.pt/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://clearbg.pt/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}