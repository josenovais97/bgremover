<?xml version="1.0" encoding="UTF-8"?>
{% comment %}A page with a real translation is listed once per language, and EVERY entry in
that cluster declares the full set of xhtml:link alternates — Google treats a page that
only names its siblings from one side as unlinked. A page that renders English under a
language prefix is listed once, in English, with no alternates: advertising it would
claim a translation that does not exist and submit a near-duplicate for indexing. The
alternate list is built per cluster in views.sitemap_xml. See TRANSLATED_PATHS.{% endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for url in urls %}  <url>
    <loc>{{ url.loc }}</loc>
{% for alt in url.alternates %}    <xhtml:link rel="alternate" hreflang="{{ alt.code }}" href="{{ alt.url }}"/>
{% endfor %}    <lastmod>{{ url.lastmod }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>{{ url.priority }}</priority>
  </url>
{% endfor %}</urlset>
